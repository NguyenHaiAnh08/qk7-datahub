NODE_ENV=production

DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=QK7_ThuVienSo
DB_USER=sa
DB_PASSWORD=CHANGE_ME_SQL_PASSWORD
DB_ENCRYPT=false
DB_TRUST_CERT=true

AI_SERVICE_URL=http://127.0.0.1:8001
