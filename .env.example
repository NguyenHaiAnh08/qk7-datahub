# ============================================================
# QK7 DATAHUB — .env TEMPLATE (KHÔNG chứa secret thật)
# ============================================================
# Cách dùng:
#   Copy-Item .env.example .env
#   notepad .env  ← Sửa các dòng CHANGE_ME
# ============================================================

SERVER_IP=192.168.1.229
SERVER_DOMAIN=trungtamdulieuso.tqsqk7.edu
USE_HTTPS=true

PORT_BACKEND=8000
PUBLIC_HTTPS_PORT=443
HTTP_REDIRECT_PORT=80
DNS_PORT=53
DNS_UPSTREAM=none
PORT_AI=8001
PORT_CADDY_HTTP=80
PORT_CADDY_HTTPS=443
PORT_CLIENT_AGENT=9001

NODE_ENV=production

DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=QK7_ThuVienSo
DB_USER=sa
DB_PASSWORD=CHANGE_ME_SQL_PASSWORD
DB_ENCRYPT=false
DB_TRUST_CERT=true

AI_SERVICE_URL=http://127.0.0.1:8001
OCR_SERVICE_URL=http://127.0.0.1:8002
BACKEND_UPLOADS_DIR=./backend/uploads
QDRANT_STORAGE_PATH=./boxchat/local_storage/qdrant_data
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_KEEP_ALIVE=3m
OLLAMA_NUM_CTX=4096
OLLAMA_EMBED_NUM_CTX=2048
OLLAMA_NUM_GPU=99
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=2
SESSION_IDLE_TIMEOUT_MINUTES=30

JWT_SECRET=CHANGE_ME_JWT_SECRET_48_BYTES_BASE64
JWT_EXPIRES_IN=8h

FP_ENC_KEY=CHANGE_ME_FP_ENC_KEY_32_BYTES_BASE64
FINGERPRINT_BRIDGE_TOKEN=CHANGE_ME_BRIDGE_TOKEN_32_CHARS_MIN
MATCH_SCORE_THRESHOLD=45

LOCKOUT_MAX_ATTEMPTS=6
LOCKOUT_WINDOW_MINUTES=15
IPBLOCK_MAX_ATTEMPTS=6
IPBLOCK_WRONG_PASSWORD_MAX_ATTEMPTS=15
IPBLOCK_WINDOW_MINUTES=15
IPBLOCK_DURATION_MINUTES=30

ENABLE_SWAGGER=false
PARSER_STRICT_MODE=false

# Đo hiệu năng (bảng đo của Quản trị viên, Ctrl+Shift+M)
PERF_TRACE=true
PERF_TRACE_KEEP=600
PERF_SAMPLE_MS=2000

CLOUDFLARE_API_TOKEN=