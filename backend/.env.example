# ============================================================
# QK7 DATAHUB — Backend Environment Variables
# ============================================================
# Cách dùng:
#   1. Copy file này thành .env  (giữ nguyên tên gốc để đối chiếu)
#   2. Sửa các giá trị cho phù hợp môi trường
#   3. KHÔNG commit file .env thật lên Git (đã có .gitignore)
#
# Lệnh copy:
#   Windows CMD:      copy .env.example .env
#   PowerShell:       Copy-Item .env.example .env
#   Linux/macOS:      cp .env.example .env
# ============================================================


# ─── Server ───
# Port Express lắng nghe (sau Nginx)
PORT=8000

# development | production
NODE_ENV=development


# ─── SQL Server ───
# Nếu SQL Server chạy CÙNG MÁY với Docker Desktop:
#     DB_SERVER=host.docker.internal
# Nếu SQL Server chạy trên MÁY KHÁC trong LAN:
#     DB_SERVER=192.168.1.100
DB_SERVER=host.docker.internal
DB_PORT=1433
DB_DATABASE=QK7_ThuVienSo
DB_USER=sa
DB_PASSWORD=1900100@Nho

# Bật mã hóa kết nối (true/false)
# Với SQL Server nội bộ không có cert → để false
DB_ENCRYPT=false

# Tin cert tự ký của SQL Server (true/false)
# Với SQL Server nội bộ → để true
DB_TRUST_CERT=true


# ─── Login Lockout (Bảo vệ đăng nhập) ───
# Khóa tài khoản sau N lần sai mật khẩu (vĩnh viễn, admin mở)
LOCKOUT_MAX_ATTEMPTS=6

# Sliding window: sai cách nhau > 15 phút thì reset đếm về 0
LOCKOUT_WINDOW_MINUTES=15

# Khóa IP sau N lần dò username không tồn tại
IPBLOCK_MAX_ATTEMPTS=6

# Window đếm dò username (phút)
IPBLOCK_WINDOW_MINUTES=15

# Thời gian khóa IP (phút)
IPBLOCK_DURATION_MINUTES=30

# ─── Swagger ───
# true  → bật  /api-docs (dev, test, training)
# false → tắt  /api-docs (production, bàn giao)
ENABLE_SWAGGER=true

# Mật khẩu Basic Auth cho Swagger (chỉ dùng khi bật Basic Auth)
# SWAGGER_PASSWORD=MatKhauSwagger@2026


 # ─── Parser ───
 PARSER_STRICT_MODE=false

# ─── Parser Thresholds (v4.3 — Configuragit
# Mật độ mực tối thiểu khi OCR header (dưới ngưỡng = giấy trắng, bỏ qua)
PARSER_HEADER_OCR_DARK_RATIO_MIN=0.005

# Ngưỡng nhị phân hóa ảnh crop header (0-255)
PARSER_HEADER_OCR_THRESHOLD=140

# Scale khi render PDF → ảnh (càng cao càng nét, càng chậm)
PARSER_RENDER_SCALE=3
PARSER_HEADER_RENDER_SCALE=4

# Số trang cuối để OCR tìm người ký (khi text không có)
PARSER_SIGNER_TAIL_PAGES=3

# Số trang đầu để OCR bổ sung metadata (khi text không có)
PARSER_EARLY_OCR_PAGES=1

# ═══════════════════════════════════════════════════════════
# APPROVAL WORKFLOW (Maker-Checker)
# ═══════════════════════════════════════════════════════════
# User ID của Quản trị viên tối cao — người DUY NHẤT được duyệt
PROTECTED_ADMIN_USER_ID=USR-001

# Role ID của Quản trị viên tối cao
PROTECTED_ADMIN_ROLE_ID=ROL-01
