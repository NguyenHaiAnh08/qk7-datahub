PORT=8000
NODE_ENV=development

DB_SERVER=191.168.1.1
DB_PORT=1433
DB_DATABASE=QK7_ThuVienSo
DB_USER=sa
DB_PASSWORD=123456
DB_ENCRYPT=false
DB_TRUST_CERT=true

LOCKOUT_MAX_ATTEMPTS=6
LOCKOUT_WINDOW_MINUTES=15
IPBLOCK_MAX_ATTEMPTS=6
IPBLOCK_WINDOW_MINUTES=15
IPBLOCK_DURATION_MINUTES=30
ENABLE_SWAGGER=true

# Ngưỡng block IP khi sai password (mới)
IPBLOCK_WRONG_PASSWORD_MAX_ATTEMPTS=6

# ─── Parser ───
PARSER_STRICT_MODE=false

# ─── JWT ✅ ĐÃ CÓ ───
# Sinh: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))" - Hiện tại lấy đại :v
JWT_SECRET=2da5b38c6ab19944c379c5ac7f93597dadcff8753cd1a428baed563dae4409e1
JWT_EXPIRES_IN=8h

# ─── FINGERPRINT 🚨 CẦN BỔ SUNG ───
# Khóa AES-256-GCM mã hóa template vân tay trong DB
# Sinh: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FP_ENC_KEY=k42yVJ1TDdgCiNX+gIFRDvddfvihwjvREJcBSPbpJkw=

# Khóa HMAC-SHA256 verify chữ ký từ Bridge
# Sinh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PHẢI copy CHÍNH XÁC giá trị này vào zk-bridge/.env → BRIDGE_HMAC_KEY

# BRIDGE_HMAC_KEY=0941aa1f3b53127213e8929294d40fae89e66504f7029d7cd2ab6d9529786b15

# ─── Legacy Auth (giai đoạn chuyển đổi) ───
# true  → Cho phép X-User-Id/X-Clearance (CHỈ DÙNG KHI DEV)
# false → Chỉ JWT (BẮT BUỘC trước production)
ALLOW_LEGACY_AUTH=false

FINGERPRINT_BRIDGE_TOKEN=qk7_fp_04560ac25f709b7e1c2e2ac38fa4b5aa5360c2e8969fe73c

USE_HTTPS=true