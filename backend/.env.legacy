# ============================================================
# QK7 DATAHUB — BACKEND ENVIRONMENT VARIABLES
# ============================================================

# ─── 1. CẤU HÌNH SERVER ───
# PORT: Cổng chạy Express Backend (mặc định 8000)
PORT=8000

# NODE_ENV: development | production
NODE_ENV=development

# ADMIN_ALLOWED_IP: Danh sách IP được phép đăng nhập vào tài khoản Admin (USR-001). 
# Cách nhau bằng dấu phẩy (VD: 192.168.1.214,127.0.0.1). 
# Nếu để trống hoặc không khớp, Admin sẽ bị chặn đăng nhập.
# ADMIN_ALLOWED_IP=

# ─── 2. CẤU HÌNH SQL SERVER (DATABASE) ───
# DB_SERVER: Nếu SQL Server chạy cùng máy (không dùng Docker) -> để localhost.
# Nếu dùng Docker Desktop -> host.docker.internal. Nếu máy khác LAN -> điền IP.
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=QK7_ThuVienSo
DB_USER=sa

# DB_PASSWORD: ⚠️ CẢNH BÁO: Mật khẩu '123456' quá yếu cho môi trường thực tế.
DB_PASSWORD=123456

# DB_ENCRYPT: Bật mã hóa kết nối. Nội bộ không có cert -> false
DB_ENCRYPT=false

# DB_TRUST_CERT: Tin tưởng cert tự ký của SQL Server nội bộ -> true
DB_TRUST_CERT=true


# ─── 3. BẢO VỆ ĐĂNG NHẬP (BRUTE-FORCE PROTECTION) ───
# LOCKOUT_MAX_ATTEMPTS: Khóa TÀI KHOẢN sau N lần sai mật khẩu liên tiếp.
LOCKOUT_MAX_ATTEMPTS=6

# LOCKOUT_WINDOW_MINUTES: Nếu thời gian giữa 2 lần sai > 15 phút, bộ đếm sẽ reset về 0.
LOCKOUT_WINDOW_MINUTES=15

# IPBLOCK_MAX_ATTEMPTS: Khóa ĐỊA CHỈ IP sau N lần dò username không tồn tại.
IPBLOCK_MAX_ATTEMPTS=6

# IPBLOCK_WINDOW_MINUTES: Cửa sổ thời gian đếm số lần IP vi phạm (phút).
IPBLOCK_WINDOW_MINUTES=15

# IPBLOCK_DURATION_MINUTES: Thời gian "giam" IP vi phạm (phút).
IPBLOCK_DURATION_MINUTES=30

# ⚠️ IPBLOCK_WRONG_PASSWORD_MAX_ATTEMPTS: Khóa IP sau N lần nhập SAI MẬT KHẨU (của các tài khoản hợp lệ).
# Đang để 6 -> Rất dễ chặn oan cả phòng ban nếu dùng chung IP NAT. Khuyên dùng: 15-20.
IPBLOCK_WRONG_PASSWORD_MAX_ATTEMPTS=15


# ─── 4. SWAGGER & PARSER ───
# ENABLE_SWAGGER: Bật giao diện test API tại /api-docs (Nên tắt khi Production).
ENABLE_SWAGGER=true

# PARSER_STRICT_MODE: Nếu true, chỉ lấy dữ liệu từ DB. Nếu false, dùng thêm regex fallback.
PARSER_STRICT_MODE=false

# ─── Parser Thresholds (v4.3 — Cấu hình thay vì Hard-code) ───
# PARSER_GARBAGE_TCVN_RATIO: Tỷ lệ ký tự lỗi font TCVN3 để kích hoạt OCR toàn bộ.
PARSER_GARBAGE_TCVN_RATIO=0.03
# PARSER_GARBAGE_MEANINGFUL_RATIO: Tỷ lệ ký tự có nghĩa tối thiểu.
PARSER_GARBAGE_MEANINGFUL_RATIO=0.3
# PARSER_OCR_CONFIDENCE_MIN: Ngưỡng tin cậy của OCR (%). Dưới ngưỡng sẽ bỏ qua.
PARSER_OCR_CONFIDENCE_MIN=70
# PARSER_HEADER_OCR_DARK_RATIO_MIN: Mật độ mực tối thiểu khi OCR header (bỏ qua giấy trắng).
PARSER_HEADER_OCR_DARK_RATIO_MIN=0.005
# PARSER_HEADER_OCR_THRESHOLD: Ngưỡng nhị phân hóa ảnh header (0-255).
PARSER_HEADER_OCR_THRESHOLD=140
# PARSER_RENDER_SCALE: Tỷ lệ phóng to khi render PDF sang ảnh (càng cao càng nét/chậm).
PARSER_RENDER_SCALE=3
PARSER_HEADER_RENDER_SCALE=4
# PARSER_SIGNER_TAIL_PAGES: Số trang cuối để OCR tìm người ký.
PARSER_SIGNER_TAIL_PAGES=3
# PARSER_EARLY_OCR_PAGES: Số trang đầu để OCR bổ sung metadata.
PARSER_EARLY_OCR_PAGES=1


# ─── 5. JWT (XÁC THỰC PHIÊN) ───
# JWT_SECRET: Khóa bí mật để tạo Token. ⚠️ Không được lộ ra ngoài.
JWT_SECRET=2da5b38c6ab19944c379c5ac7f93597dadcff8753cd1a428baed563dae4409e1
# JWT_EXPIRES_IN: Thời gian sống của Token (8 giờ).
JWT_EXPIRES_IN=8h


# ─── 6. FINGERPRINT (VÂN TAY ZK9500) ───
# FP_ENC_KEY: Khóa AES-256-GCM dùng để mã hóa Template vân tay lưu trong DB.
# ⚠️ Nếu mất key này, toàn bộ vân tay đã đăng ký sẽ không thể giải mã (phải enroll lại).
FP_ENC_KEY=k42yVJ1TDdgCiNX+gIFRDvddfvihwjvREJcBSPbpJkw=
# FINGERPRINT_BRIDGE_TOKEN: Token xác thực kết nối WebSocket từ Agent (máy Client) lên Server.
FINGERPRINT_BRIDGE_TOKEN=qk7_fp_04560ac25f709b7e1c2e2ac38fa4b5aa5360c2e8969fe73c


# ─── 7. SECURITY & AUTH (SPRINT 2) ───
# USE_HTTPS: Bật nếu chạy giao thức HTTPS/WSS. Nếu chạy LAN HTTP -> false.
USE_HTTPS=false
# FINGERPRINT_ALLOW_PLAIN_WS: Cho phép Agent kết nối WS không mã hóa (chỉ dùng cho LAN).
FINGERPRINT_ALLOW_PLAIN_WS=true
# ALLOW_LEGACY_AUTH: ⚠️ Bắt buộc để false trên Production. Chỉ true khi Dev (cho phép fake IP/Header).
ALLOW_LEGACY_AUTH=false
# CORS_ALLOWED_ORIGINS: Danh sách domain được phép gọi API. Để trống = same-origin.
CORS_ALLOWED_ORIGINS=
# ENABLE_TEST_ENDPOINTS: Bật/tắt các API test lỗi HTTP. Production nên để false.
ENABLE_TEST_ENDPOINTS=true


# ═══════════════════════════════════════════════════════════
# 8. APPROVAL WORKFLOW (Maker-Checker) & PROTECTED ADMIN
# ═══════════════════════════════════════════════════════════
# PROTECTED_ADMIN_USER_ID: Người DUY NHẤT được phép phê duyệt các yêu cầu nguy hiểm.
PROTECTED_ADMIN_USER_ID=USR-001
# PROTECTED_ADMIN_ROLE_ID: Role ID của Quản trị viên tối cao (Bypass toàn bộ hệ thống).
PROTECTED_ADMIN_ROLE_ID=ROL-01