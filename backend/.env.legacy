# ============================================================
# QK7 DATAHUB — BACKEND ENVIRONMENT VARIABLES
# ============================================================

# ─── Server ───
PORT=8000
NODE_ENV=development

# ─── SQL Server ───
DB_SERVER=192.168.1.229
DB_PORT=1433
DB_DATABASE=QK7_ThuVienSo
DB_USER=sa
DB_PASSWORD=123456
DB_ENCRYPT=false
DB_TRUST_CERT=true

# ─── Bảo vệ đăng nhập (Brute-force Protection) ───
LOCKOUT_MAX_ATTEMPTS=6
LOCKOUT_WINDOW_MINUTES=15
IPBLOCK_MAX_ATTEMPTS=6
IPBLOCK_WINDOW_MINUTES=15
IPBLOCK_DURATION_MINUTES=30
IPBLOCK_WRONG_PASSWORD_MAX_ATTEMPTS=6

# ─── Swagger & Parser ───
ENABLE_SWAGGER=true
PARSER_STRICT_MODE=false

# ─── Parser Thresholds (v4.3 — Cấu hình thay vì Hard-code) ───
PARSER_GARBAGE_TCVN_RATIO=0.03
PARSER_GARBAGE_MEANINGFUL_RATIO=0.3
PARSER_OCR_CONFIDENCE_MIN=70
PARSER_HEADER_OCR_DARK_RATIO_MIN=0.005
PARSER_HEADER_OCR_THRESHOLD=140
PARSER_RENDER_SCALE=3
PARSER_HEADER_RENDER_SCALE=4
PARSER_SIGNER_TAIL_PAGES=3
PARSER_EARLY_OCR_PAGES=1

# ─── JWT ───
JWT_SECRET=2da5b38c6ab19944c379c5ac7f93597dadcff8753cd1a428baed563dae4409e1
JWT_EXPIRES_IN=8h

# ─── Fingerprint ───
# Khóa AES-256-GCM mã hóa template vân tay trong DB
FP_ENC_KEY=k42yVJ1TDdgCiNX+gIFRDvddfvihwjvREJcBSPbpJkw=
# Token xác thực WebSocket kết nối từ Agent (phải khớp với máy Client)
FINGERPRINT_BRIDGE_TOKEN=qk7_fp_04560ac25f709b7e1c2e2ac38fa4b5aa5360c2e8969fe73c

# ─── Security & Auth (Sprint 2) ───
# Nếu dùng HTTPS/WSS thì đổi thành true
USE_HTTPS=false

# Cho phép fingerprint WS chạy không mã hóa (chỉ dùng cho LAN nội bộ)
FINGERPRINT_ALLOW_PLAIN_WS=true

# true → Cho phép X-User-Id/X-Clearance (CHỈ DÙNG KHI DEV)
# false → Chỉ JWT (BẮT BUỘC trước production)
ALLOW_LEGACY_AUTH=false

# CORS: Để trống = chỉ same-origin. 
# Nếu chạy Vite dev độc lập (port 5173) hãy điền: http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Bật/tắt endpoint test (mặc định dev = true, prod = false)
ENABLE_TEST_ENDPOINTS=true

# ─── Protected Admin (Bảo vệ tài khoản tối cao) ───
PROTECTED_ADMIN_USER_ID=USR-001
PROTECTED_ADMIN_ROLE_ID=ROL-01

# ═══════════════════════════════════════════════════════════
# APPROVAL WORKFLOW (Maker-Checker)
# ═══════════════════════════════════════════════════════════
# User ID của Quản trị viên tối cao — người DUY NHẤT được duyệt
PROTECTED_ADMIN_USER_ID=USR-001

# Role ID của Quản trị viên tối cao
PROTECTED_ADMIN_ROLE_ID=ROL-01