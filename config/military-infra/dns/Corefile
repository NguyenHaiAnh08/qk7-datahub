# ==============================================================================
# CoreDNS Configuration — QK7 DataHub Autonomous Military DNS (100% Air-Gapped)
# Quy mô: Cấp Đơn vị (500 máy) -> Cấp Toàn quân (1.000.000+ thiết bị Anycast)
# KHÔNG forward ra Internet công cộng — Tự chủ phân giải hoàn toàn nội bộ.
# ==============================================================================

tqsqk7.edu:53 {
    # Nạp file Zone thẩm quyền (tự động reload mỗi 5 giây khi đổi IP bằng doi-ip.bat)
    file /etc/coredns/tqsqk7.edu.zone tqsqk7.edu {
        reload 5s
    }

    # Hỗ trợ đồng bộ Zone (AXFR) xuống các DNS Slave tại Sư đoàn/Lữ đoàn/Quân khu
    transfer {
        to *
    }

    # Bộ nhớ đệm hiệu năng cao (chịu tải > 100.000 QPS/node)
    cache 30
    errors
    log
    health :8080
    ready :8181
}

# Reverse DNS / Fallback nội bộ (từ chối truy vấn ra Internet trong mạng Air-Gapped)
.:53 {
    errors
    cache 30
    template ANY ANY {
        rcode NXDOMAIN
    }
}
