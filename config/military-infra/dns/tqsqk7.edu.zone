; ==============================================================================
; RFC 1035 Authoritative DNS Zone  tqsqk7.edu (QK7 DataHub Air-Gapped Military LAN)
; Cap nhat tu dong boi: scripts\setup-military-dns.ps1 | scripts\doi-ip.bat
; Khi doi IP may chu tren quy mo 1.000.000 thiet bi: CHI dOI IP TAI dAY!
; ==============================================================================
$ORIGIN tqsqk7.edu.
$TTL 30

@               IN SOA  dns1.tqsqk7.edu. admin.tqsqk7.edu. (
                        2026112316 ; Serial (YYYYMMDDHH)
                        60         ; Refresh (Slave DNS dong bo moi 60s)
                        15         ; Retry
                        604800     ; Expire (7 ngay neu mat ket noi lien tinh)
                        30 )       ; Minimum Negative TTL

; May chu DNS Tham quyen (Master / Slave Anycast)
@               IN NS   dns1.tqsqk7.edu.
@               IN NS   dns2.tqsqk7.edu.

dns1            IN A    192.168.1.229
dns2            IN A    192.168.1.229

; Cong Trung Tam Du Lieu So QK7 DataHub (https://trungtamdulieuso.tqsqk7.edu)
trungtamdulieuso IN A        192.168.1.229
api             IN CNAME trungtamdulieuso.tqsqk7.edu.
ca              IN A    192.168.1.229
soc             IN CNAME trungtamdulieuso.tqsqk7.edu.