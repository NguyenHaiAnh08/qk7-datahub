# ==============================================================================
# Template Chứng Chỉ Leaf Server TLS — https://trungtamdulieuso.tqsqk7.edu
# Tương thích 100% Chrome/Edge/Safari (iPadOS 18+), Windows Root Store & ZKTeco Agent
# Giá trị __SERVER_DOMAIN__ và __SERVER_IP__ sẽ được thay tự động bởi script PKI.
# ==============================================================================
[ req ]
default_bits        = 2048
distinguished_name  = req_distinguished_name
req_extensions      = req_ext
string_mask         = utf8only
default_md          = sha256
prompt              = no

[ req_distinguished_name ]
C  = VN
ST = Ho Chi Minh City
L  = Quan Khu 7
O  = Truong Quan Su Quan Khu 7
OU = Trung Tam Du Lieu So
CN = __SERVER_DOMAIN__

[ req_ext ]
basicConstraints       = CA:FALSE
keyUsage               = critical, digitalSignature, keyEncipherment
extendedKeyUsage       = serverAuth
subjectAltName         = @alt_names

[ alt_names ]
DNS.1 = __SERVER_DOMAIN__
DNS.2 = tqsqk7.cntt
DNS.3 = localhost
IP.1  = __SERVER_IP__
IP.2  = 127.0.0.1
IP.3  = ::1
